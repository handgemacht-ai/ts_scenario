{
  "name": "ts_scenario",
  "private": true,
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/cjs/index.js" },
    "./seed": { "types": "./dist/public/seed.d.ts", "import": "./dist/public/seed.js", "require": "./dist/cjs/public/seed.js" },
    "./testing": { "types": "./dist/public/testing.d.ts", "import": "./dist/public/testing.js", "require": "./dist/cjs/public/testing.js" },
    "./types": { "types": "./dist/domain/types.d.ts", "import": "./dist/domain/types.js", "require": "./dist/cjs/domain/types.js" },
    "./runtime/node": { "types": "./dist/runtime/node.d.ts", "import": "./dist/runtime/node.js", "require": "./dist/cjs/runtime/node.js" }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node scripts/write-cjs-package-json.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worktree-hook": "vitest run tests/worktree-create-hook.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
